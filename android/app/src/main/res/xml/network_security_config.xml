<?xml version="1.0" encoding="utf-8"?>
<!-- Открытый (cleartext) трафик разрешён ТОЛЬКО к локальному шлюзу приложения
     (http/ws на 127.0.0.1). Весь остальной cleartext запрещён — раньше
     usesCleartextTraffic=true разрешал его всему приложению. Связь с мостом
     всегда идёт по TLS с пиннингом. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
