<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: запрещаем и облачный бэкап, и перенос на новое устройство.
     Токен доступа и настройки не должны утекать копированием данных приложения. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
